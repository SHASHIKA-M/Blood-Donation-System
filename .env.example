# Copy to .env or set as environment variables on your host / Render / Railway / Azure
PORT=8088

# Real SQL Server (example: Azure SQL / local SA auth)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=Blood_Connect;encrypt=true;trustServerCertificate=true;loginTimeout=10;
DB_USERNAME=sa
DB_PASSWORD=change-me-strong-password
DB_POOL_SIZE=10

# Prod safety: false in real world (stops demo pass123 seeding), true for local demo
APP_SEED=false
DDL_AUTO=validate
SHOW_SQL=false
SESSION_TIMEOUT=30m
LOG_LEVEL=INFO
